# IDE integration (machine-specific)
ide/

# User-specific project memories & plans
projects/
plans/

# Plugins (installed separately per machine)
plugins/

# Backups & archives
backups/
*.zip
*.bak

# Downloads
downloads/

# Local memories
.codex
.claude
.gemini
.agents
.doflow
.opencode
.pi
GEMINI.md
AGENTS.md
# Ignore agent-docs CONTENTS rather than the directory itself: git will not descend into an
# excluded directory, so a negation below it can never re-include anything.
agent-docs/*
# ...except the DoFlow chain artifacts. These carry the requirements, design decisions,
# supersessions and execution record for a feature — the reasoning behind a branch, which is
# exactly what a reviewer needs and what git is for. They were lost once to this ignore rule.
!agent-docs/doflow/
# Nested copies inside recorded bench eval outputs are artifacts of past runs, not this repo's
# working documents. The original `agent-docs/` rule matched at any depth; `agent-docs/*` above is
# root-anchored, so they need naming explicitly.
bench/runs/**/agent-docs/
.mcp.json

# MkDocs build output
site/

# Python bytecode — do-code-review bundles Python analyzers under
# core/shared/skills/do-code-review/scripts/, so importing or byte-compiling one
# leaves artifacts inside the shipped tree
__pycache__/
*.py[cod]

# OS files
.DS_Store
Thumbs.db
/CLAUDE.md
