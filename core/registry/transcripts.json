{
  "version": 1,
  "entries": [
    {
      "harness": "claude",
      "reader": "claude-jsonl",
      "status": "supported",
      "locations": [
        { "os": "darwin", "base": "env:CLAUDE_CONFIG_DIR", "segments": ["projects"], "glob": "{cwdEncoded}/{sessionId}.jsonl" },
        { "os": "linux", "base": "env:CLAUDE_CONFIG_DIR", "segments": ["projects"], "glob": "{cwdEncoded}/{sessionId}.jsonl" },
        { "os": "darwin", "base": "home", "segments": [".claude", "projects"], "glob": "{cwdEncoded}/{sessionId}.jsonl" },
        { "os": "linux", "base": "home", "segments": [".claude", "projects"], "glob": "{cwdEncoded}/{sessionId}.jsonl" },
        { "os": "win32", "base": "home", "segments": [".claude", "projects"], "glob": "{cwdEncoded}/{sessionId}.jsonl", "status": "unknown" }
      ],
      "format": "jsonl",
      "appendOnly": "yes",
      "join": "session-id",
      "requiredKeys": ["type", "timestamp", "sessionId"],
      "evidence": [
        "https://code.claude.com/docs/en/sessions",
        "https://code.claude.com/docs/en/hooks"
      ],
      "verifiedOn": "2026-10-26",
      "versions": null
    },
    {
