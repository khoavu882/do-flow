{
  "version": 1,
  "description": "Categories for sorting the loose files a user drops into a feature's additional-context/ folder. A rule matches on file name and extension only, never on content. Categories are tried in order, rules in order, and the first match wins; a package adds categories through the intake-category contribution point.",
  "recentWindowSeconds": 60,
  "pointerMaxBytes": 262144,
  "textExtensions": ["md", "txt", "mmd", "puml", "vtt", "srt", "json", "yaml", "yml", "csv", "html"],
  "promptCategory": "prompt",
  "categories": [
    {
      "id": "raw-prd",
      "names": ["prd", "requirements"],
      "summary": "Product requirement documents, briefs and stories as the user wrote them.",
      "rules": [
        { "extensions": ["md", "txt", "pdf", "docx"], "namePattern": "prd|requirement|brief|epic|(^|[^a-z0-9])(user[-_ ]?)?(story|stories)([^a-z0-9]|$)" }
      ]
    },
    {
      "id": "hld",
      "names": ["design", "architecture"],
      "summary": "High-level design notes, diagram sources and their rendered images.",
      "rules": [
        { "extensions": ["mmd", "puml", "drawio", "excalidraw"], "into": "diagrams" },
        { "extensions": ["png", "svg", "jpg", "jpeg"], "companionOf": ["mmd", "puml", "drawio", "excalidraw"] },
        { "extensions": ["md"], "namePattern": "^(?!.*(transcript|meeting|minutes|session[-_ ]?notes)).*(hld|high[-_ ]?level|design|architecture|decision|adr)" }
      ]
    },
    {
      "id": "discuss-session",
      "names": ["meetings"],
      "summary": "Recordings, transcripts and notes of a discussion.",
      "rules": [
        { "extensions": ["mp3", "m4a", "wav", "ogg", "mp4", "mov", "webm"], "into": "records" },
        { "extensions": ["vtt", "srt"], "into": "transcripts" },
        { "extensions": ["txt", "md"], "namePattern": "transcript|meeting|minutes|discuss|session", "into": "transcripts" },
        { "extensions": ["txt"], "namePattern": "^(\\d{1,2}-\\d{1,2}-\\d{4}|\\d{4}-\\d{2}-\\d{2})", "into": "transcripts" }
      ]
    },
    {
      "id": "references",
      "names": ["docs", "vendor-docs"],
      "summary": "Reference documents, spreadsheets and vendor material.",
      "rules": [
        { "extensions": ["pdf", "docx", "xlsx", "pptx", "html"] }
      ]
    },
    {
      "id": "prompt",
      "names": [],
      "summary": "Context pasted into the prompt, filed verbatim by the intake verb; no rule sorts a file here.",
      "rules": []
    }
  ]
}
