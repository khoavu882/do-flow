{
  "version": 1,
  "tools": [
    {
      "id": "rtk",
      "displayName": "RTK (Rust Token Killer)",
      "role": "optional",
      "unlocks": "Provides the command.compress capability: compresses command output so an agent reads fewer tokens.",
      "officialEvidence": [
        "https://github.com/rtk-ai/rtk/blob/develop/INSTALL.md",
        "https://www.rtk-ai.app/docs/getting-started/installation/"
      ],
      "status": {
        "commands": [
          [
            "rtk",
            "--version"
          ],
          [
            "rtk",
            "gain"
          ]
        ]
      },
      "install": {
        "command": [
          "cargo",
          "install",
          "--git",
          "https://github.com/rtk-ai/rtk",
          "--branch",
          "master",
          "rtk"
        ]
      },
      "uninstall": {
        "command": [
          "cargo",
          "uninstall",
          "rtk"
        ]
      }
    },
    {
      "id": "graphify",
      "displayName": "Graphify",
      "role": "optional",
      "unlocks": "Provides the code.relationships and code.impact-analysis capabilities: call graphs and the blast radius of a change.",
      "officialEvidence": [
        "https://github.com/Graphify-Labs/graphify/blob/v8/README.md",
        "https://docs.astral.sh/uv/guides/tools/",
        "https://docs.astral.sh/uv/reference/cli/"
      ],
      "prerequisites": [
        "uv"
      ],
      "status": {
        "commands": [
          [
            "graphify",
            "--version"
          ]
        ]
      },
      "install": {
        "command": [
          "uv",
          "tool",
          "install",
          "graphifyy"
        ]
      },
      "update": {
        "command": [
          "uv",
          "tool",
          "upgrade",
          "graphifyy"
        ]
      },
      "uninstall": {
        "command": [
          "uv",
          "tool",
          "uninstall",
          "graphifyy"
        ]
      }
    },
    {
      "id": "semble",
      "displayName": "Semble",
      "role": "optional",
      "unlocks": "Provides the code.semantic-search capability: finds code by meaning instead of by exact text.",
      "officialEvidence": [
        "https://github.com/MinishLab/semble"
      ],
      "prerequisites": [
        "uv"
      ],
      "status": {
        "commands": [
          [
            "semble",
            "--version"
          ]
        ]
      },
      "install": {
        "command": [
          "uv",
          "tool",
          "install",
          "semble"
        ]
      },
      "update": {
        "command": [
          "uv",
          "tool",
          "upgrade",
          "semble"
        ]
      },
      "uninstall": {
        "command": [
          "uv",
          "tool",
          "uninstall",
          "semble"
        ]
      }
    },
    {
      "id": "mermaid-cli",
      "displayName": "Mermaid CLI",
      "role": "optional",
      "unlocks": "Renders Mermaid diagrams to images (doflow-run render-diagrams); without it the diagram source is kept as text.",
      "officialEvidence": [
        "https://github.com/mermaid-js/mermaid-cli/blob/master/README.md",
        "https://github.com/mermaid-js/mermaid/blob/develop/docs/config/usage.md"
      ],
      "status": {
        "commands": [
          [
            "mmdc",
            "--version"
          ]
        ]
      },
      "install": {
        "command": [
          "npm",
          "install",
          "-g",
          "@mermaid-js/mermaid-cli"
        ]
      },
      "uninstall": {
        "command": [
          "npm",
          "uninstall",
          "-g",
          "@mermaid-js/mermaid-cli"
        ]
      }
    },
    {
      "id": "plantuml",
      "displayName": "PlantUML",
      "role": "optional",
      "unlocks": "Renders the C4 .puml sources to images (doflow-run render-puml); without it only the .puml source exists.",
      "officialEvidence": [
        "https://plantuml.com/starting",
        "https://github.com/plantuml-stdlib/C4-PlantUML/blob/master/README.md"
      ],
      "status": {
        "commands": [
          [
            "plantuml",
            "-version"
          ]
        ]
      },
      "install": {
        "command": [
          "brew",
          "install",
          "plantuml"
        ]
      },
      "uninstall": {
        "command": [
          "brew",
          "uninstall",
          "plantuml"
        ]
      }
    }
  ]
}
