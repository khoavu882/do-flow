{
  "version": 1,
  "tools": [
    {
      "id": "rtk",
      "displayName": "RTK (Rust Token Killer)",
      "role": "optional",
      "unlocks": "Provides the command.compress capability: compresses command output so an agent reads fewer tokens.",
      "officialEvidence": [
        "https://github.com/rtk-ai/rtk/blob/develop/INSTALL.md",
        "https://www.rtk-ai.app/docs/getting-started/installation/"
      ],
      "status": {
        "commands": [
          [
            "rtk",
            "--version"
          ],
          [
            "rtk",
            "gain"
          ]
        ]
      },
      "install": {
        "routes": [
          {
            "installer": "cargo",
            "command": [
              "cargo",
              "install",
              "--git",
              "https://github.com/rtk-ai/rtk",
              "--branch",
              "master",
              "rtk"
            ],
            "evidence": "https://www.rtk-ai.app/docs/getting-started/installation/"
          },
          {
            "installer": "brew",
            "command": [
              "brew",
              "install",
              "rtk-ai/tap/rtk"
            ],
            "evidence": "https://www.rtk-ai.app/docs/getting-started/installation/"
          }
        ]
      },
      "uninstall": {
        "command": [
          "cargo",
          "uninstall",
          "rtk"
        ]
      }
    },
