{
  "version": 1,
  "tools": [
    {
      "id": "rtk",
      "displayName": "RTK (Rust Token Killer)",
      "officialEvidence": [
        "https://github.com/rtk-ai/rtk/blob/develop/INSTALL.md",
        "https://www.rtk-ai.app/docs/getting-started/installation/"
      ],
      "status": {
        "commands": [
          [
            "rtk",
            "--version"
          ],
          [
            "rtk",
            "gain"
          ]
        ]
      },
      "install": {
        "command": [
          "cargo",
          "install",
          "--git",
          "https://github.com/rtk-ai/rtk",
          "--branch",
          "master",
          "rtk"
        ]
      },
      "uninstall": {
        "command": [
          "cargo",
          "uninstall",
          "rtk"
        ]
      }
    },
    {
      "id": "graphify",
      "displayName": "Graphify",
      "officialEvidence": [
        "https://github.com/Graphify-Labs/graphify/blob/v8/README.md",
        "https://docs.astral.sh/uv/guides/tools/",
        "https://docs.astral.sh/uv/reference/cli/"
      ],
      "prerequisites": [
        "uv"
      ],
      "status": {
        "commands": [
          [
            "graphify",
            "--version"
          ]
        ]
      },
      "install": {
        "command": [
          "uv",
          "tool",
          "install",
          "graphifyy"
        ]
      },
      "update": {
        "command": [
          "uv",
          "tool",
          "upgrade",
          "graphifyy"
        ]
      },
      "uninstall": {
        "command": [
          "uv",
          "tool",
          "uninstall",
          "graphifyy"
        ]
      }
    },
    {
      "id": "semble",
      "displayName": "Semble",
      "officialEvidence": [
        "https://github.com/MinishLab/semble"
      ],
      "prerequisites": [
        "uv"
      ],
      "status": {
        "commands": [
          [
            "semble",
            "--version"
          ]
        ]
      },
      "install": {
        "command": [
          "uv",
          "tool",
          "install",
          "semble"
        ]
      },
      "update": {
        "command": [
          "uv",
          "tool",
          "upgrade",
          "semble"
        ]
      },
      "uninstall": {
        "command": [
          "uv",
          "tool",
          "uninstall",
          "semble"
        ]
      }
    },
    {
      "id": "mermaid-cli",
      "displayName": "Mermaid CLI",
      "officialEvidence": [
        "https://github.com/mermaid-js/mermaid-cli/blob/master/README.md",
        "https://github.com/mermaid-js/mermaid/blob/develop/docs/config/usage.md"
      ],
      "status": {
        "commands": [
          [
            "mmdc",
            "--version"
          ]
        ]
      },
      "install": {
        "command": [
          "npm",
          "install",
          "-g",
          "@mermaid-js/mermaid-cli"
        ]
      },
      "uninstall": {
        "command": [
          "npm",
          "uninstall",
          "-g",
          "@mermaid-js/mermaid-cli"
        ]
      }
    }
  ]
}
