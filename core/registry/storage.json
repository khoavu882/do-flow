{
  "version": 1,
  "description": "Declared DoFlow storage retention catalogue.",
  "settings": {
    "optOutFile": "prune",
    "upkeepIntervalHours": 24,
    "passBudgetMs": 750,
    "maxRemovalsPerPass": 5000,
    "passLockStaleSeconds": 120,
    "orphanGraceHours": 24,
    "staleTmpHours": 24,
    "ignoreFile": {
      "name": ".gitignore",
      "lines": [
        "# DoFlow runtime state: local to this machine, kept out of git by DoFlow.",
        "# Removed by `doflow remove` when DoFlow leaves this project.",
        "*",
        "!/ledger.json"
      ]
    }
  },
  "roots": {
    "project-doflow": {
      "base": "project",
      "segments": [
        ".doflow"
      ]
    },
    "project-state": {
      "base": "project",
      "segments": [
        ".doflow",
        "state"
      ]
    },
    "user-doflow": {
      "base": "home",
      "segments": [
        ".doflow"
      ]
    },
    "user-state": {
      "base": "home",
      "segments": [
        ".doflow",
        "state"
      ]
    },
    "config-home": {
      "base": "xdg-config",
      "segments": [
        "doflow"
      ]
    }
  },
  "stores": [
    {
      "id": "verification-logs",
      "root": "project-state",
      "path": "verification/logs",
      "entry": "file",
      "match": "^[0-9]{13}-[A-Za-z0-9._-]+\\.log$",
      "rule": "count-and-age",
      "bound": {
        "keepNewest": 40,
        "maxAgeDays": 30
      },
      "protect": "open-work",
      "moments": [
        "verify",
        "verb"
      ],
      "writers": [
        "src/runtime/verification/contract-runner.ts"
      ]
    },
    {
      "id": "verification-runs",
      "root": "project-state",
      "path": "verification/runs",
      "entry": "record",
      "match": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.jsonl$",
      "rule": "work",
      "bound": {
        "finishedDays": 30
      },
      "protect": null,
      "moments": [
        "verify",
        "verb"
      ],
      "writers": [
        "src/runtime/verification/engine.ts"
      ]
    },
    {
      "id": "verification-v0",
      "root": "project-state",
      "path": "verification/v0",
      "entry": "file",
      "match": "^[A-Za-z0-9._-]+$",
      "rule": "count-and-age",
      "bound": {
        "keepNewest": 40,
        "maxAgeDays": 7
      },
      "protect": null,
      "moments": [
        "verify",
        "verb"
      ],
      "writers": [
        "src/runtime/verification/engine.ts",
        "src/runtime/verification/inflight.ts"
      ]
    },
    {
      "id": "task-evidence",
      "root": "project-state",
      "path": "evidence",
      "entry": "record",
      "match": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$",
      "rule": "work",
      "bound": {
        "finishedDays": 30
      },
      "protect": null,
      "moments": [
        "verb"
      ],
      "writers": [
        "src/runtime/task-state.ts"
      ]
    },
    {
      "id": "task-delivery",
      "root": "project-state",
      "path": "delivery",
      "entry": "record",
      "match": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$",
      "rule": "work",
      "bound": {
        "finishedDays": 30
      },
      "protect": null,
      "moments": [
        "verb"
      ],
      "writers": [
        "src/runtime/task-state.ts"
      ]
    },
    {
      "id": "task-readiness",
      "root": "project-state",
      "path": "readiness",
      "entry": "record",
      "match": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$",
      "rule": "work",
      "bound": {
        "finishedDays": 30
      },
      "protect": null,
      "moments": [
        "verb"
      ],
      "writers": [
        "src/runtime/readiness-record.ts",
        "src/runtime/task-state.ts"
      ]
    },
    {
      "id": "task-research",
      "root": "project-state",
      "path": "research",
      "entry": "record",
      "match": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$",
      "rule": "work",
      "bound": {
        "finishedDays": 30
      },
      "protect": null,
      "moments": [
        "verb"
      ],
      "writers": [
        "src/runtime/task-state.ts"
      ]
    },
    {
      "id": "task-outcome",
      "root": "project-state",
      "path": "outcome",
      "entry": "record",
      "match": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$",
      "rule": "work",
      "bound": {
        "finishedDays": 30
      },
      "protect": null,
      "moments": [
        "verb"
      ],
      "writers": [
        "src/runtime/outcome.ts"
      ]
    },
    {
      "id": "task-retrieval",
      "root": "project-state",
      "path": "retrieval",
      "entry": "record",
      "match": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$",
      "rule": "work",
      "bound": {
        "finishedDays": 30
      },
      "protect": null,
      "moments": [
        "verb"
      ],
      "writers": [
        "src/runtime/task-state.ts",
        "src/runtime/retrieval-record.ts"
      ]
    },
    {
      "id": "task-attempts",
      "root": "project-state",
      "path": "task-attempts",
      "entry": "record",
      "match": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$",
      "rule": "work",
      "bound": {
        "finishedDays": 30
      },
      "protect": null,
      "moments": [
        "verb"
      ],
      "writers": [
        "src/runtime/task-state.ts"
      ]
    },
    {
      "id": "worker-runs",
      "root": "project-state",
      "path": "worker-runs",
      "entry": "record",
      "match": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$",
      "rule": "work",
      "bound": {
        "finishedDays": 30
      },
      "protect": null,
      "moments": [
        "verb"
      ],
      "writers": [
        "src/runtime/task-state.ts"
      ]
    },
    {
      "id": "worker-probes",
      "root": "project-state",
      "path": "worker-probes",
      "entry": "file",
      "match": "^[a-z][a-z0-9-]*\\.json$",
      "rule": "count-and-age",
      "bound": {
        "keepNewest": 16,
        "maxAgeDays": 30
      },
      "protect": null,
      "moments": [
        "verb"
      ],
      "writers": [
        "src/runtime/task-state.ts"
      ]
    },
    {
      "id": "worker-output",
      "root": "project-state",
      "path": "worker-output",
      "entry": "file",
      "match": "^w-[0-9a-f]{12}\\.(out|err|last)\\.log$",
      "rule": "count-and-age",
      "bound": {
        "keepNewest": 200,
        "maxAgeDays": 30
      },
      "protect": null,
      "moments": [
        "verb"
      ],
      "writers": [
        "src/runtime/worker/supervisor.ts"
      ]
    },
    {
      "id": "dispatch",
      "root": "project-state",
      "path": "dispatch",
      "entry": "record",
      "match": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$",
      "rule": "work",
      "bound": {
        "finishedDays": 30
      },
      "protect": null,
      "moments": [
        "verb"
      ],
      "writers": [
        "src/runtime/task-state.ts"
      ]
    },
    {
      "id": "roadmap",
      "root": "project-state",
      "path": "roadmap",
      "entry": "record",
      "match": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$",
      "rule": "work",
      "bound": {
        "finishedDays": 30
      },
      "protect": null,
      "moments": [],
      "writers": [
        "src/runtime/roadmap/merge.ts",
        "src/runtime/roadmap/loop.ts"
      ]
    },
    {
      "id": "dispatch-envelopes",
      "root": "project-state",
      "path": "dispatch-envelopes",
      "entry": "file",
      "match": "^d-[0-9a-f]{12}(?:\\.c[1-4])?\\.[a-z][a-z-]{0,31}\\.(?:json|txt)$",
      "rule": "count-and-age",
      "bound": {
        "keepNewest": 400,
        "maxAgeDays": 30
      },
      "protect": null,
      "moments": [
        "verb"
      ],
      "writers": [
        "src/runtime/dispatch/envelope.ts",
        "src/runtime/dispatch/grants.ts"
      ]
    },
    {
      "id": "dispatch-worktrees",
      "root": "project-state",
      "path": "dispatch-worktrees",
      "entry": "dir",
      "match": "^[pd]-[0-9a-f]{12}(?:\\.c[1-4])?$",
      "rule": "existing",
      "bound": {
        "text": "attempt worktrees removed by dispatch cleanup; the integration worktree stays for the user to merge"
      },
      "protect": null,
      "moments": [],
      "writers": [
        "src/runtime/worktree.ts"
      ],
      "source": {
        "file": "src/runtime/dispatch/integrate.ts",
        "pattern": "removeVerified"
      }
    },
    {
      "id": "task-orchestration",
      "root": "project-state",
      "path": "orchestration",
      "entry": "record",
      "match": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$",
      "rule": "work",
      "bound": {
        "finishedDays": 30
      },
      "protect": null,
      "moments": [
        "verb"
      ],
      "writers": [
        "src/runtime/task-state.ts",
        "src/runtime/workflow-orchestrator.ts"
      ]
    },
    {
      "id": "runs-project",
      "root": "project-state",
      "path": "runs",
      "entry": "file",
      "match": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.jsonl$",
      "rule": "date-partition",
      "bound": {
        "maxAgeDays": 180
      },
      "protect": null,
      "moments": [
        "verb"
      ],
      "writers": [
        "core/shared/scripts/doflow/bin/doflow-run",
        "src/runtime/trace/ledger.ts"
      ]
    },
    {
      "id": "runs-telemetry",
      "root": "project-state",
      "path": "runs/telemetry",
      "entry": "file",
      "match": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.jsonl$",
      "rule": "date-partition",
      "bound": {
        "maxAgeDays": 180
      },
      "protect": null,
      "moments": [
        "verb"
      ],
      "writers": [
        "core/harnesses/shared/hooks/bridge/bridge.sh",
        "core/harnesses/claude/hooks/post-shell-observe.sh",
        "src/runtime/trace/telemetry.ts"
      ]
    },
    {
      "id": "runs-user",
      "root": "user-state",
      "path": "runs",
      "entry": "file",
      "match": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.jsonl$",
      "rule": "date-partition",
      "bound": {
        "maxAgeDays": 180
      },
      "protect": null,
      "moments": [
        "verb"
      ],
      "writers": [
        "core/shared/scripts/doflow/bin/doflow-run",
        "src/runtime/trace/ledger.ts"
      ]
    },
    {
      "id": "advice-picks-project",
      "root": "project-state",
      "path": "advice/picks",
      "entry": "file",
      "match": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.jsonl$",
      "rule": "date-partition",
      "bound": {
        "maxAgeDays": 90
      },
      "protect": null,
      "moments": [
        "verb"
      ],
      "writers": [
        "src/runtime/advice/record.ts"
      ]
    },
    {
      "id": "advice-picks-user",
      "root": "user-state",
      "path": "advice/picks",
      "entry": "file",
      "match": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.jsonl$",
      "rule": "date-partition",
      "bound": {
        "maxAgeDays": 90
      },
      "protect": null,
      "moments": [
        "verb"
      ],
      "writers": [
        "src/runtime/advice/record.ts"
      ]
    },
    {
      "id": "recovery-user",
      "root": "user-state",
      "path": "recovery",
      "entry": "file",
      "match": "^recovery_[A-Za-z0-9_-]+\\.json$",
      "rule": "recovery",
      "bound": {
        "keepNewest": 3
      },
      "protect": null,
      "moments": [
        "install"
      ],
      "writers": [
        "src/state/index.ts"
      ]
    },
    {
      "id": "recovery-project",
      "root": "project-state",
      "path": "recovery",
      "entry": "file",
      "match": "^recovery_[A-Za-z0-9_-]+\\.json$",
      "rule": "recovery",
      "bound": {
        "keepNewest": 3
      },
      "protect": null,
      "moments": [
        "install"
      ],
      "writers": [
        "src/state/index.ts"
      ]
    },
    {
      "id": "lifecycle-events",
      "root": "project-state",
      "path": "lifecycle/events",
      "entry": "file",
      "match": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$",
      "rule": "lifecycle-settled",
      "bound": {
        "defaultHours": 4320
      },
      "protect": null,
      "moments": [
        "lifecycle-verb",
        "verb"
      ],
      "writers": [
        "src/runtime/lifecycle/event-store.ts"
      ]
    },
    {
      "id": "report-bodies",
      "root": "config-home",
      "path": "reports",
      "entry": "dir",
      "match": "^[0-9a-f]{12}$",
      "rule": "report-orphan",
      "bound": {
        "orphanGraceHours": 24,
        "foreignMaxAgeDays": 180
      },
      "protect": null,
      "moments": [
        "verb"
      ],
      "writers": [
        "src/runtime/lifecycle/report-store.ts",
        "src/runtime/storage/engine.ts"
      ]
    },
    {
      "id": "session-dirs",
      "root": "config-home",
      "path": "session-env/sessions",
      "entry": "dir",
      "match": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "rule": "age",
      "bound": {
        "maxAgeDays": 30
      },
      "protect": null,
      "moments": [
        "session",
        "verb"
      ],
      "writers": [
        "core/harnesses/claude/hooks/lib.sh",
        "core/harnesses/claude/hooks/permission-audit.sh",
        "core/harnesses/claude/hooks/post-edit-lint.sh",
        "core/harnesses/claude/hooks/post-tool-failure.sh",
        "core/harnesses/claude/hooks/skill-config-audit.sh",
        "core/harnesses/codex/hooks/lib.sh",
        "core/harnesses/codex/hooks/post-edit-lint.impl.sh",
        "core/harnesses/gemini/hooks/lib.sh",
        "core/harnesses/gemini/hooks/post-edit-lint.sh",
        "core/harnesses/kiro/hooks/lib.sh",
        "core/harnesses/shared/hooks/policies/emission.sh",
        "core/harnesses/shared/hooks/policies/identity.sh",
        "core/harnesses/shared/hooks/policies/lib.sh",
        "core/harnesses/shared/hooks/policies/session-context.sh",
        "core/harnesses/shared/hooks/policies/stop-check.sh",
        "core/harnesses/shared/hooks/policies/subagent-audit.sh",
        "src/runtime/context/arbitrate.ts",
        "src/runtime/context/identity.ts"
      ]
    },
    {
      "id": "project-dirs",
      "root": "config-home",
      "path": "session-env/projects",
      "entry": "dir",
      "match": "^[0-9a-f]{16}$",
      "rule": "age",
      "bound": {
        "maxAgeDays": 90
      },
      "protect": null,
      "moments": [
        "session",
        "verb"
      ],
      "writers": [
        "core/harnesses/claude/hooks/lib.sh",
        "core/harnesses/claude/hooks/post-compact.sh",
        "core/harnesses/claude/hooks/session-end.sh",
        "core/harnesses/codex/hooks/lib.sh",
        "core/harnesses/codex/hooks/session-end.impl.sh",
        "core/harnesses/gemini/hooks/lib.sh",
        "core/harnesses/gemini/hooks/session-end.impl.sh",
        "core/harnesses/kiro/hooks/lib.sh",
        "core/harnesses/shared/hooks/policies/lib.sh",
        "core/harnesses/shared/hooks/policies/session-context.sh",
        "src/runtime/context/arbitrate.ts"
      ]
    },
    {
      "id": "summary-scopes",
      "root": "config-home",
      "path": "session-env/summaries",
      "entry": "dir",
      "match": "^[0-9a-f]{16}$",
      "rule": "age",
      "bound": {
        "maxAgeDays": 90
      },
      "protect": null,
      "moments": [
        "session",
        "verb"
      ],
      "writers": [
        "core/harnesses/shared/hooks/policies/summary-store.sh",
        "src/runtime/context/summary-store.ts"
      ]
    },
    {
      "id": "summary-grants",
      "root": "config-home",
      "path": "session-env/grants",
      "entry": "dir",
      "match": "^[A-Za-z0-9][A-Za-z0-9_-]{0,55}$",
      "rule": "age",
      "bound": {
        "maxAgeDays": 90
      },
      "protect": null,
      "moments": [
        "session",
        "verb"
      ],
      "writers": [
        "core/harnesses/shared/hooks/policies/summary-store.sh",
        "src/runtime/context/summary-store.ts"
      ]
    },
    {
      "id": "installer-backups-user-doflow",
      "root": "user-doflow",
      "path": "backups",
      "entry": "dir",
      "match": "^[A-Za-z0-9._-]+$",
      "rule": "existing",
      "bound": {
        "value": 3,
        "text": "keep 3"
      },
      "protect": null,
      "moments": [],
      "writers": [
        "src/install/backup.ts"
      ],
      "source": {
        "file": "src/install/backup.ts",
        "pattern": "DEFAULT_BACKUP_RETENTION = {value}"
      }
    },
    {
      "id": "installer-backups-project-doflow",
      "root": "project-doflow",
      "path": "backups",
      "entry": "dir",
      "match": "^[A-Za-z0-9._-]+$",
      "rule": "existing",
      "bound": {
        "value": 3,
        "text": "keep 3"
      },
      "protect": null,
      "moments": [],
      "writers": [
        "src/install/backup.ts"
      ],
      "source": {
        "file": "src/install/backup.ts",
        "pattern": "DEFAULT_BACKUP_RETENTION = {value}"
      }
    },
    {
      "id": "nudge-markers",
      "root": "config-home",
      "path": "session-env/nudge",
      "entry": "file",
      "match": "^[A-Za-z0-9._-]+$",
      "rule": "existing",
      "bound": {
        "value": 30,
        "text": "prune after 30 days"
      },
      "protect": null,
      "moments": [],
      "writers": [
        "core/harnesses/shared/hooks/policies/lib.sh"
      ],
      "source": {
        "file": "core/harnesses/shared/hooks/policies/lib.sh",
        "pattern": "-mtime +{value}"
      }
    },
    {
      "id": "sessions-log",
      "root": "config-home",
      "path": "sessions.log",
      "entry": "file",
      "match": "^sessions\\.log$",
      "rule": "existing",
      "bound": {
        "value": 500,
        "text": "keep last 500 lines"
      },
      "protect": null,
      "moments": [],
      "writers": [
        "core/harnesses/claude/hooks/lib.sh",
        "core/harnesses/claude/hooks/session-end.sh",
        "core/harnesses/codex/hooks/lib.sh",
        "core/harnesses/codex/hooks/session-end.impl.sh",
        "core/harnesses/gemini/hooks/lib.sh",
        "core/harnesses/gemini/hooks/session-end.impl.sh",
        "core/harnesses/kiro/hooks/lib.sh",
        "core/harnesses/shared/hooks/policies/lib.sh",
        "core/harnesses/shared/hooks/policies/session-context.sh"
      ],
      "source": {
        "file": "core/harnesses/claude/hooks/session-end.sh",
        "pattern": "tail -n {value}"
      }
    },
    {
      "id": "failure-events",
      "root": "config-home",
      "path": "failures",
      "entry": "file",
      "match": "^[A-Za-z0-9._-]+$",
      "rule": "existing",
      "bound": {
        "value": 4,
        "text": "keep 4 rotated files"
      },
      "protect": null,
      "moments": [],
      "writers": [
        "core/harnesses/shared/hooks/policies/capture-failure.sh",
        "core/harnesses/shared/hooks/stream-hook-runner.js",
        "core/shared/scripts/doflow/bin/doflow-run",
        "src/runtime/failure/capture.ts",
        "src/runtime/failure/store.ts"
      ],
      "source": {
        "file": "src/runtime/failure/capture.ts",
        "pattern": "KEEP_ROTATED = {value}"
      }
    },
    {
      "id": "autopilot-switch",
      "root": "config-home",
      "path": "autopilot",
      "entry": "file",
      "match": "^off$",
      "rule": "existing",
      "bound": {
        "text": "one sentinel file; only a person removes it"
      },
      "protect": null,
      "moments": [],
      "writers": [
        "src/runtime/settings/autopilot.ts"
      ],
      "source": {
        "file": "src/runtime/settings/autopilot.ts",
        "pattern": "path.join(home, 'autopilot', 'off')"
      }
    },
    {
      "id": "roadmap-audit",
      "root": "project-state",
      "path": "roadmap/audit.jsonl",
      "entry": "file",
      "match": "^audit\\.jsonl$",
      "rule": "existing",
      "bound": {
        "value": 10000,
        "text": "keep the last 10000 gate and merge entries"
      },
      "protect": null,
