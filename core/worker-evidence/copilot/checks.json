{
  "schema": "doflow-worker-checks-v1",
  "harness": "copilot",
  "binary": "copilot",
  "version": { "argv": ["--version"], "expect": "^GitHub Copilot CLI \\d+\\.\\d+\\.\\d+" },
  "checks": [
    {
      "id": "print-one-shot",
      "argv": ["--help"],
      "expect": [
        "^Usage: copilot \\[OPTIONS\\] \\[COMMAND\\]",
        "^\\s+-p, --prompt <text>$",
        "Execute a prompt in non-interactive mode",
        "^\\s+--trust-folder$",
        "^\\s+--no-ask-user$"
      ],
      "establishes": ["runnableProbe", "oneShot"]
    },
    {
      "id": "structured-output",
      "argv": ["--help"],
      "expect": ["^\\s+--output-format <format>$", "\\(JSONL, one JSON"],
      "establishes": ["structuredOutput"]
    },
    {
      "id": "read-only-flags",
      "argv": ["--help"],
      "expect": ["^\\s+--deny-tool \\[<tools>\\.\\.\\.\\]$", "Tools the CLI does not have permission to use", "^\\s+--available-tools \\[<tools>\\.\\.\\.\\]$", "Only these tools will be available to the model"],
      "establishes": ["readOnly"]
    },
    {
      "id": "spawn-denial-flags",
      "argv": ["--help"],
      "expect": ["^\\s+--excluded-tools \\[<tools>\\.\\.\\.\\]$", "These tools will not be available to the model"],
      "establishes": ["spawnDenial"]
    },
    {
      "id": "help-model",
      "argv": ["--help"],
      "expect": ["^\\s+--model <model>$"],
      "establishes": ["model"]
    },
    {
      "id": "help-effort",
      "argv": ["--help"],
      "expect": [
        "^\\s+--reasoning-effort <level>$",
        "Set the reasoning effort level \\[possible values: none, minimal, low, medium, high, xhigh, max\\]$"
      ],
      "establishes": ["effort"]
    },
    {
      "id": "widening-flags",
      "argv": ["--help"],
      "expect": [
        "^\\s+--trust-folder$",
        "^\\s+--allow-all-tools$",
        "^\\s+--allow-all-paths$",
        "^\\s+--allow-all-urls$",
        "^\\s+--allow-all$",
        "^\\s+--allow-tool \\[<tools>\\.\\.\\.\\]$",
        "^\\s+--allow-url \\[<urls>\\.\\.\\.\\]$",
        "^\\s+--yolo$",
        "^\\s+--add-dir <directory>$",
        "^\\s+--mode <mode>$",
        "possible values: interactive, plan, autopilot\\]$",
        "^\\s+--autopilot$",
        "^\\s+--assisted-approval$"
      ],
      "establishes": ["mainSession"]
    }
  ]
}
