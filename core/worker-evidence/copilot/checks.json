{
  "schema": "doflow-worker-checks-v1",
  "harness": "copilot",
  "binary": "copilot",
  "version": { "argv": ["--version"], "expect": "^GitHub Copilot CLI \\d+\\.\\d+\\.\\d+" },
  "checks": [
    {
      "id": "print-one-shot",
      "argv": ["--help"],
      "expect": [
        "^Usage: copilot \\[OPTIONS\\] \\[COMMAND\\]",
        "^\\s+-p, --prompt <text>$",
        "Execute a prompt in non-interactive mode",
        "^\\s+--trust-folder$",
        "^\\s+--no-ask-user$"
      ],
      "establishes": ["runnableProbe", "oneShot"]
    },
    {
      "id": "structured-output",
      "argv": ["--help"],
      "expect": ["^\\s+--output-format <format>$", "\\(JSONL, one JSON"],
      "establishes": ["structuredOutput"]
    },
    {
      "id": "read-only-flags",
      "argv": ["--help"],
      "expect": ["^\\s+--deny-tool \\[<tools>\\.\\.\\.\\]$", "Tools the CLI does not have permission to use"],
      "establishes": ["readOnly"]
    },
    {
      "id": "spawn-denial-flags",
      "argv": ["--help"],
      "expect": ["^\\s+--excluded-tools \\[<tools>\\.\\.\\.\\]$", "These tools will not be available to the model"],
      "establishes": ["spawnDenial"]
    },
    {
      "id": "help-model",
      "argv": ["--help"],
      "expect": ["^\\s+--model <model>$"],
      "establishes": ["model"]
    }
  ]
}
