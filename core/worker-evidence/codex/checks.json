{
  "schema": "doflow-worker-checks-v1",
  "harness": "codex",
  "binary": "codex",
  "version": { "argv": ["--version"], "expect": "^codex-cli \\d+\\.\\d+\\.\\d+" },
  "checks": [
    {
      "id": "exec-one-shot",
      "argv": ["exec", "--help"],
      "expect": ["^Usage: codex exec \\[OPTIONS\\] \\[PROMPT\\]", "instructions are read from stdin"],
      "establishes": ["runnableProbe", "oneShot"]
    },
    {
      "id": "exec-json",
      "argv": ["exec", "--help"],
      "expect": ["^\\s+--json$", "Print events to stdout as JSONL", "-o, --output-last-message"],
      "establishes": ["structuredOutput"]
    },
    {
      "id": "exec-sandbox",
      "argv": ["exec", "--help"],
      "expect": ["-s, --sandbox <SANDBOX_MODE>", "read-only, workspace-write"],
      "establishes": ["readOnly", "isolatedEdit"]
    },
    {
      "id": "spawn-denial",
      "argv": ["features", "list", "--disable", "multi_agent", "--disable", "multi_agent_v2"],
      "expect": ["^multi_agent\\s+\\S+\\s+false$", "^multi_agent_v2\\s+\\S+\\s+false$"],
      "establishes": ["spawnDenial"]
    },
    {
      "id": "exec-model",
      "argv": ["exec", "--help"],
      "expect": ["^\\s+-m, --model <MODEL>$"],
      "establishes": ["model"]
    },
    {
      "id": "exec-main-session",
      "argv": ["exec", "--help"],
      "expect": [
        "^Usage: codex exec \\[OPTIONS\\] \\[PROMPT\\]",
        "\\(or if `-` is used\\)",
        "instructions are read from stdin",
        "^\\s+--json$",
        "-o, --output-last-message <FILE>"
      ],
      "establishes": ["mainSession"]
    },
    {
      "id": "widening-flags-exec",
      "argv": ["exec", "--help"],
      "expect": [
        "^\\s+-c, --config <key=value>$",
        "sandbox_permissions=",
        "^\\s+--enable <FEATURE>$",
        "^\\s+-s, --sandbox <SANDBOX_MODE>$",
        "\\[possible values: read-only, workspace-write, danger-full-access\\]",
        "^\\s+--approve-for-me$",
        "^\\s+--dangerously-bypass-approvals-and-sandbox$",
        "^\\s+--dangerously-bypass-hook-trust$",
        "^\\s+-C, --cd <DIR>$",
        "^\\s+--add-dir <DIR>$",
        "^\\s+--ignore-user-config$",
        "^\\s+--ignore-rules$"
      ],
      "establishes": ["mainSession"]
    },
    {
      "id": "widening-flags",
      "argv": ["--help"],
      "expect": [
        "^\\s+-a, --ask-for-approval <APPROVAL_POLICY>$",
        "^\\s+- never:",
        "^\\s+--search$"
      ],
      "establishes": ["mainSession"]
    }
  ]
}
