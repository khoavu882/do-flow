{
  "schema": "doflow-worker-checks-v1",
  "harness": "pi",
  "binary": "pi",
  "version": { "argv": ["--version"], "expect": "^\\d+\\.\\d+\\.\\d+" },
  "checks": [
    {
      "id": "print-one-shot",
      "argv": ["--help"],
      "expect": [
        "^\\s+pi \\[options\\] \\[--\\] \\[@files\\.\\.\\.\\] \\[messages\\.\\.\\.\\]",
        "^\\s+--print, -p\\s+Non-interactive mode: process prompt and exit",
        "^\\s+--no-session\\s+Don't save session",
        "^\\s+--thinking <level>\\s+Set thinking level: off,",
        "^\\s+--no-skills, -ns\\s+Disable skills discovery",
        "^\\s+--no-context-files, -nc\\s+Disable AGENTS\\.md and CLAUDE\\.md",
        "^\\s+--offline\\s+Disable startup network operations"
      ],
      "establishes": ["runnableProbe", "oneShot"]
    },
    {
      "id": "structured-output",
      "argv": ["--help"],
      "expect": ["^\\s+--mode <mode>\\s+Output mode: text \\(default\\), json, or rpc"],
      "establishes": ["structuredOutput"]
    },
    {
      "id": "read-only-flags",
      "argv": ["--help"],
      "expect": ["^\\s+--tools, -t <tools>\\s+Comma-separated allowlist of tool names"],
      "establishes": ["readOnly"]
    },
    {
      "id": "spawn-denial-flags",
      "argv": ["--help"],
      "expect": [
        "^\\s+--no-extensions, -ne\\s+Disable extension discovery",
        "^\\s+--no-mcp\\s+Disable built-in MCP support"
      ],
      "establishes": ["spawnDenial"]
    },
    {
      "id": "help-model",
      "argv": ["--help"],
      "expect": ["^\\s+--model <pattern>\\s"],
      "establishes": ["model"]
    },
    {
      "id": "main-session",
      "argv": ["--help"],
      "expect": [
        "^\\s+pi \\[options\\] \\[--\\] \\[@files\\.\\.\\.\\] \\[messages\\.\\.\\.\\]",
        "^\\s+--print, -p\\s+Non-interactive mode: process prompt and exit",
        "^\\s+--mode <mode>\\s+Output mode: text \\(default\\), json, or rpc",
        "^\\s+--\\s+End option parsing; treat remaining arguments as messages/files"
      ],
      "establishes": ["mainSession"]
    },
    {
      "id": "widening-flags",
      "argv": ["--help"],
      "expect": [
        "^\\s+--approve, -a\\s+Trust project-local files"
      ],
      "establishes": ["mainSession"]
    },
    {
      "id": "project-trust",
      "argv": ["--help"],
      "expect": [
        "^\\s+--no-approve, -na\\s+Ignore project-local files for this run"
      ],
      "establishes": ["mainSession"]
    },
    {
      "id": "secret-commands",
      "argv": ["auth", "--help"],
      "expect": [
        "^\\s+pi auth print-api-key\\b",
        "^\\s+pi auth print-bearer-token\\b",
        "^\\s+--credentials\\s+Emit the credential"
      ],
      "establishes": ["mainSession"]
    },
    {
      "id": "login-recipe",
      "argv": ["auth", "--help"],
      "expect": [
        "^\\s+pi auth check \\[--provider <provider>\\] \\[--model <model>\\] \\[--json\\]",
        "^\\s+check\\s+Print ready, not_ready, or invalid; exit with 0, 1, or 2",
        "^\\s+--no-refresh\\s+Do not refresh expired OAuth credentials during check"
      ],
      "establishes": ["loginProbe"]
    },
    {
      "id": "help-provider",
      "argv": ["--help"],
      "expect": ["^\\s+--model <pattern>\\s+Model pattern or ID \\(supports \"provider/id\""],
      "establishes": ["provider"]
    },
    {
      "id": "help-thinking",
      "argv": ["--help"],
      "expect": ["^\\s+--thinking <level>\\s+Set thinking level: off, minimal, low, medium, high, xhigh, max$"],
      "establishes": ["effort"]
    }
  ]
}
