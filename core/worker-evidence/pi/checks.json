{
  "schema": "doflow-worker-checks-v1",
  "harness": "pi",
  "binary": "pi",
  "version": { "argv": ["--version"], "expect": "^\\d+\\.\\d+\\.\\d+" },
  "checks": [
    {
      "id": "print-one-shot",
      "argv": ["--help"],
      "expect": [
        "^\\s+pi \\[options\\] \\[--\\] \\[@files\\.\\.\\.\\] \\[messages\\.\\.\\.\\]",
        "^\\s+--print, -p\\s+Non-interactive mode: process prompt and exit",
        "^\\s+--no-session\\s+Don't save session",
        "^\\s+--thinking <level>\\s+Set thinking level: off,",
        "^\\s+--no-skills, -ns\\s+Disable skills discovery",
        "^\\s+--no-context-files, -nc\\s+Disable AGENTS\\.md and CLAUDE\\.md",
        "^\\s+--offline\\s+Disable startup network operations"
      ],
      "establishes": ["runnableProbe", "oneShot"]
    },
    {
      "id": "structured-output",
      "argv": ["--help"],
      "expect": ["^\\s+--mode <mode>\\s+Output mode: text \\(default\\), json, or rpc"],
      "establishes": ["structuredOutput"]
    },
    {
      "id": "read-only-flags",
      "argv": ["--help"],
      "expect": ["^\\s+--tools, -t <tools>\\s+Comma-separated allowlist of tool names"],
      "establishes": ["readOnly"]
    },
    {
      "id": "spawn-denial-flags",
      "argv": ["--help"],
      "expect": [
        "^\\s+--no-extensions, -ne\\s+Disable extension discovery",
        "^\\s+--no-mcp\\s+Disable built-in MCP support"
      ],
      "establishes": ["spawnDenial"]
    },
    {
      "id": "help-model",
      "argv": ["--help"],
      "expect": ["^\\s+--model <pattern>\\s"],
      "establishes": ["model"]
    }
  ]
}
