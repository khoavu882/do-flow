{
  "name": "doflow",
  "description": "DoFlow main session: spec-driven delivery with lifecycle hooks and specialist dispatch",
  "prompt": "You are the DoFlow main session. Follow the DoFlow steering files under .kiro/steering (principles, rules, the spec-driven chain) and the skills under .kiro/skills. Dispatch specialist work by role to core-implementer, delivery-lead, quality-guardian, reviewer, spec-analyst, system-architect or research-writer, and keep decisions, verification and records in this session.\n",
  "tools": [
    "*"
  ],
  "hooks": [
    {
      "name": "doflow-pre-implementation-gate",
      "trigger": "preToolUse",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "bash \"$(root=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$root/.kiro/hooks/pre-implement-gate.sh\" ] && printf '%s/.kiro/hooks/pre-implement-gate.sh' \"$root\" || printf '%s/.kiro/hooks/pre-implement-gate.sh' \"$HOME\")\""
      },
      "timeout": 10
    },
    {
      "name": "doflow-pre-bash-guard",
      "trigger": "preToolUse",
      "matcher": "shell",
      "action": {
        "type": "command",
        "command": "bash \"$(root=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$root/.kiro/hooks/pre-bash-guard.sh\" ] && printf '%s/.kiro/hooks/pre-bash-guard.sh' \"$root\" || printf '%s/.kiro/hooks/pre-bash-guard.sh' \"$HOME\")\""
      },
      "timeout": 10
    },
    {
      "name": "doflow-mcp-tool-guard",
      "trigger": "preToolUse",
      "matcher": "*",
      "action": {
        "type": "command",
        "command": "bash \"$(root=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$root/.kiro/hooks/mcp-tool-guard.sh\" ] && printf '%s/.kiro/hooks/mcp-tool-guard.sh' \"$root\" || printf '%s/.kiro/hooks/mcp-tool-guard.sh' \"$HOME\")\""
      },
      "timeout": 10
    },
    {
      "name": "doflow-session-context",
      "trigger": "agentSpawn",
      "action": {
        "type": "command",
        "command": "bash \"$(root=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$root/.kiro/hooks/session-start.sh\" ] && printf '%s/.kiro/hooks/session-start.sh' \"$root\" || printf '%s/.kiro/hooks/session-start.sh' \"$HOME\")\""
      },
      "timeout": 10
    },
    {
      "name": "doflow-stop-check",
      "trigger": "stop",
      "action": {
        "type": "command",
        "command": "bash \"$(root=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$root/.kiro/hooks/stop-check.sh\" ] && printf '%s/.kiro/hooks/stop-check.sh' \"$root\" || printf '%s/.kiro/hooks/stop-check.sh' \"$HOME\")\""
      },
      "timeout": 30
    }
  ]
}
