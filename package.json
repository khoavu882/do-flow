{
  "name": "@khoavu882/doflow",
  "version": "2.0.0-beta.3",
  "description": "DoFlow config installer — npx CLI for the registry-driven multi-harness install/update/remove lifecycle",
  "keywords": [
    "claude-code",
    "codex",
    "gemini",
    "opencode",
    "ai-coding-agent",
    "skills",
    "hooks",
    "mcp",
    "cli"
  ],
  "homepage": "https://github.com/khoavu882/do-flow#readme",
  "bugs": {
    "url": "https://github.com/khoavu882/do-flow/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khoavu882/do-flow.git"
  },
  "author": "Khoa Vu Dang",
  "bin": {
    "doflow": "bin/doflow.js"
  },
  "engines": {
    "node": "^22.18.0 || >=24.3.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "typecheck": "npx -y -p typescript@5.7.2 tsc -p tsconfig.json",
    "build:package": "node src/release/build-package.ts .pack",
    "bench": "node bench/runner.js",
    "drift": "node scripts/check-format-drift.js",
    "release-notes": "node src/release/changelog-section.ts",
    "version": "node src/release/sync-plugin-versions.ts && git add core/.codex-plugin/plugin.json core/.claude-plugin/plugin.json core/.plugin/plugin.json"
  },
  "files": [
    "bin/",
    "src/",
    "core/",
    "types/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
