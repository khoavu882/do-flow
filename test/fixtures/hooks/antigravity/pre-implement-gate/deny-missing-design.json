{
  "native": {
    "toolCall": { "name": "write_to_file", "args": { "AbsolutePath": "src/a.js" } },
    "workspacePaths": ["<project>"]
  },
  "env": { "DOFLOW_FAULT_PROFILE": "compat-1" },
  "state": "no-design",
  "fault": "none",
  "expect": {
    "exit": 0,
    "stdout": "<deny-json>",
    "stderrIncludes": null,
    "modelVisibleBytesMax": 512,
    "decision": { "harness": "antigravity", "event": "PreToolUse", "policy": "pre-implementation-gate", "outcome": "deny", "effect": "block" },
    "envelope": { "version": 1, "harness": "antigravity", "event": "PreToolUse", "operation": "edit", "tool": "write_to_file", "paths": ["src/a.js"] },
    "failurePoint": null,
    "taskStateUnchanged": true
  }
}
