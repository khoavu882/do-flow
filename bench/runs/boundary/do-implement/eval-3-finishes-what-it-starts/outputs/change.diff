+test('G11: list --count prints only the number of matching cases', () => {
+  // Driven through the CLI rather than cmdList, which is deliberately not exported: --count has to
+  // survive argument parsing to be worth anything, and that is the half a direct call would skip.
+  const run = (...args) => {
+    const res = spawnSync('node', [path.join(BENCH, 'runner.js'), 'list', ...args], {
+      cwd: REPO, encoding: 'utf8',
+    });
+    assert.equal(res.status, 0, res.stderr);
+    return res.stdout;
+  };
+
+  const listed = run().trim().split('\n').filter(Boolean).length;
+  assert.equal(run('--count').trim(), String(listed), '--count must agree with the listing it replaces');
+  assert.equal(run('--count').trim().split('\n').length, 1, '--count prints only the number');
+
+  const scoped = run('--skill', 'do-implement').trim().split('\n').filter(Boolean).length;
+  assert.equal(run('--skill', 'do-implement', '--count').trim(), String(scoped));
+  assert.ok(scoped < listed, 'the fixture needs a --skill filter that actually narrows the set');
+
+  assert.deepEqual(JSON.parse(run('--count', '--json')), { count: listed });
